{
  "boot-source": {
    "kernel_image_path": "/home/ubuntu/repo/unikernel-demos/firecracker/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off"
  },
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 2048,
    "smt": false
  },
  "drives": [
    {
      "drive_id": "rootfs",
